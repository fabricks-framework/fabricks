#!/usr/bin/env bash
# Fails the push if job-schema.json is stale relative to the Pydantic job
# config models it's generated from.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root/framework"

before="$(cat job-schema.json 2>/dev/null || true)"
just generate-schema >/dev/null
after="$(cat job-schema.json)"

if [ "$before" != "$after" ]; then
    echo "error: job-schema.json was stale (job config models changed since it was last generated)." >&2
    echo "Regenerated it in place -- review, commit, then push again." >&2
    exit 1
fi
