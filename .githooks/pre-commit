#!/usr/bin/env bash
# Formats and lints staged Python changes before commit.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
staged="$(git -C "$repo_root" diff --name-only --cached --diff-filter=ACMR)"

cd "$repo_root/framework"

# Only the staged files, so unrelated files stay untouched; CI runs `just lint` on the whole tree.
staged_here="$(git diff --name-only --cached --diff-filter=ACMR --relative -- fabricks tests)"
if [ -n "$staged_here" ]; then
    echo "$staged_here" | xargs just format
    echo "$staged_here" | xargs just lint
    echo "$staged_here" | xargs just lint-comments
fi

# format/lint may have rewritten files -- only re-stage ones that were
# already staged for this commit, not every dirty file in the tree.
if [ -n "$staged" ]; then
    echo "$staged" | (cd "$repo_root" && xargs -r git add --)
fi
