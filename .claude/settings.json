{
  "statusLine": {
    "type": "command",
    "command": "bash \"/Users/francois.poskin/.claude/plugins/cache/ponytail/ponytail/4.8.3/hooks/ponytail-statusline.sh\""
  },
  "permissions": {
    "allow": [
      "Bash(./framework/format.sh:*)",
      "Bash(pytest:*)",
      "Bash(git status:)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(uv run:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Read",
      "Grep",
      "Glob"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Invoke the ponytail:ponytail skill before answering.'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd framework && ./format.sh -ty {{toolUse.file_path}}"
          },
          {
            "type": "command",
            "command": "cd framework && ./format.sh -python {{toolUse.file_path}}"
          },
          {
            "type": "command",
            "command": "cd framework && ./format.sh -sql {{toolUse.file_path}}"
          },
          {
            "type": "command",
            "command": "cd framework && ./format.sh -yaml {{toolUse.file_path}}"
          }
        ]
      }
    ]
  }
}